   669     00FC                     clear_ram0:	
   670                           ;	Called with FSR containing the base address, and
   671                           ;	W with the last address+1
   672                           
   673     00FC  0064               	clrwdt	;clear the watchdog before getting into this loop
   674     00FD                     clrloop0:
   675     00FD  0180               	clrf	0	;clear RAM location pointed to by FSR
   676     00FE  0A84               	incf	4,f	;increment pointer
   677     00FF  0604               	xorwf	4,w	;XOR with final address
   678     0100  1903               	btfsc	3,2	;have we reached the end yet?
   679     0101  3400               	retlw	0	;all done for this memory range, return
   680     0102  0604               	xorwf	4,w	;XOR again to restore value
   681     0103  28FD               	goto	clrloop0	;do the next byte
