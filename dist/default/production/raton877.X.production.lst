  2405                           ;Config register CONFIG @ 0x2007
  2406                           ;	Oscillator Selection bits
  2407                           ;	FOSC = HS, HS oscillator
  2408                           ;	Watchdog Timer Enable bit
  2409                           ;	WDTE = OFF, WDT disabled
  2410                           ;	Power-up Timer Enable bit
  2411                           ;	PWRTE = ON, PWRT enabled
  2412                           ;	Brown-out Reset Enable bit
  2413                           ;	BOREN = ON, BOR enabled
  2414                           ;	Low-Voltage (Single-Supply) In-Circuit Serial Programming Enable bit
  2415                           ;	LVP = OFF, RB3 is digital I/O, HV on MCLR must be used for programming
  2416                           ;	Data EEPROM Memory Code Protection bit
  2417                           ;	CPD = OFF, Data EEPROM code protection off
