  4915                           ;Config register CONFIG @ 0x2007
  4916                           ;	Oscillator Selection bits
  4917                           ;	FOSC = HS, HS oscillator
  4918                           ;	Watchdog Timer Enable bit
  4919                           ;	WDTE = OFF, WDT disabled
  4920                           ;	Power-up Timer Enable bit
  4921                           ;	PWRTE = ON, PWRT enabled
  4922                           ;	Brown-out Reset Enable bit
  4923                           ;	BOREN = ON, BOR enabled
  4924                           ;	Low-Voltage (Single-Supply) In-Circuit Serial Programming Enable bit
